// server/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

enum SubscriptionStatus {
  DRAFT
  QUOTATION
  CONFIRMED
  ACTIVE
  PAUSED
  CLOSED
}

enum BillingFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum PaymentTerms {
  IMMEDIATE
  NET15
  NET30
  NET60
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  EXPIRED
  REJECTED
}

model User {
  id             String    @id @default(uuid())
  name           String
  email          String    @unique
  passwordHash   String
  role           Role      @default(CUSTOMER)
  company        String?
  avatar         String?
  customerId     String?   @unique
  customer       Customer? @relation(fields: [customerId], references: [id])
  resetToken     String?
  resetTokenExp  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([email])
  @@index([role])
}

model Customer {
  id                       String         @id @default(uuid())
  name                     String
  email                    String         @unique
  phone                    String?
  company                  String
  address                  String?
  taxNumber                String?
  status                   String         @default("active")
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  user                     User?
  quotations               Quotation[]
  subscriptions            Subscription[]

  @@index([email])
  @@index([status])
}

model Product {
  id         String           @id @default(uuid())
  name       String
  type       String
  salesPrice Float
  costPrice  Float
  notes      String?
  status     String           @default("active")
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  variants   ProductVariant[]

  @@index([status])
}

model ProductVariant {
  id              String  @id @default(uuid())
  productId       String
  product         Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name            String
  sku             String  @unique
  priceAdjustment Float   @default(0)
  description     String?

  @@index([productId])
}

model Plan {
  id                            String           @id @default(uuid())
  name                          String
  code                          String           @unique
  billingFrequency              BillingFrequency
  minimumQuantity               Int              @default(1)
  price                         Float
  availableFrom                 DateTime
  availableUntil                DateTime
  autoRenewDefault              Boolean          @default(false)
  earlyClosurePenaltyPercentage Float            @default(0)
  pauseAllowed                  Boolean          @default(false)
  maxPauseDays                  Int              @default(0)
  description                   String?
  status                        String           @default("active")
  createdAt                     DateTime         @default(now())
  updatedAt                     DateTime         @updatedAt

  quotationTemplates QuotationTemplate[]
  quotations         Quotation[]
  subscriptions      Subscription[]

  @@index([status])
  @@index([code])
}

model QuotationTemplate {
  id            String                     @id @default(uuid())
  name          String
  description   String?
  planId        String
  plan          Plan                       @relation(fields: [planId], references: [id])
  validityDays  Int                        @default(30)
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt

  defaultLines  QuotationTemplateLineItem[]
  quotations    Quotation[]

  @@index([planId])
}

model QuotationTemplateLineItem {
  id         String            @id @default(uuid())
  templateId String
  template   QuotationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  productId  String
  variantId  String?
  quantity   Int               @default(1)

  @@index([templateId])
}

model Quotation {
  id              String             @id @default(uuid())
  quotationNumber String             @unique
  customerId      String
  customer        Customer           @relation(fields: [customerId], references: [id])
  planId          String
  plan            Plan               @relation(fields: [planId], references: [id])
  templateId      String?
  template        QuotationTemplate? @relation(fields: [templateId], references: [id])
  status          QuotationStatus    @default(DRAFT)
  validUntil      DateTime
  subtotal        Float              @default(0)
  taxAmount       Float              @default(0)
  discountAmount  Float              @default(0)
  totalAmount     Float              @default(0)
  notes           String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  lines           QuotationLineItem[]

  @@index([customerId])
  @@index([status])
  @@index([planId])
}

model QuotationLineItem {
  id          String    @id @default(uuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId   String
  productName String
  variantId   String?
  variantName String?
  quantity    Int
  unitPrice   Float
  taxRate     Float     @default(0)
  lineTotal   Float

  @@index([quotationId])
}

model Subscription {
  id                      String             @id @default(uuid())
  subscriptionNumber      String             @unique
  customerId              String
  customer                Customer           @relation(fields: [customerId], references: [id])
  planId                  String
  plan                    Plan               @relation(fields: [planId], references: [id])
  billingFrequency        BillingFrequency
  status                  SubscriptionStatus @default(DRAFT)
  startDate               DateTime
  expiryDate              DateTime
  nextBillingDate         DateTime
  paymentTerms            PaymentTerms       @default(NET30)
  taxReference            String?
  subtotal                Float              @default(0)
  taxTotal                Float              @default(0)
  totalAmount             Float              @default(0)
  pauseReason             String?
  pausedAt                DateTime?
  pauseDaysRemaining      Int?
  autoRenew               Boolean            @default(false)
  renewalNotificationDays Int                @default(14)
  closedAt                DateTime?
  closureReason           String?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  lines                   SubscriptionLineItem[]
  // Member 2 will add: invoices Invoice[]

  @@index([customerId])
  @@index([status])
  @@index([planId])
  @@index([nextBillingDate])
}

model SubscriptionLineItem {
  id             String       @id @default(uuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  productId      String
  productName    String
  variantId      String?
  variantName    String?
  quantity       Int
  unitPrice      Float
  taxRate        Float        @default(0)
  lineTotal      Float

  @@index([subscriptionId])
}

