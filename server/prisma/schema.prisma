datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// MEMBER 1 MODELS (Interfaces / References)
// ==========================================

model User {
  id         String    @id @default(cuid())
  name       String
  email      String    @unique
  role       String    @default("customer") // admin | staff | customer
  company    String?
  customerId String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Customer {
  id          String         @id @default(cuid())
  name        String
  email       String
  phone       String?
  company     String?
  address     String?
  taxNumber   String?
  status      String         @default("active")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  
  // Relations to Member 2
  invoices    Invoice[]
  payments    Payment[]
  subscriptions Subscription[]
}

model Product {
  id          String             @id @default(cuid())
  name        String
  type        String
  salesPrice  Float
  costPrice   Float
  status      String             @default("active")
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  
  discountProducts DiscountProduct[]
  invoiceLines     InvoiceLine[]
  subscriptionLines SubscriptionLine[]
}

model Subscription {
  id                     String             @id @default(cuid())
  subscriptionNumber     String             @unique
  customerId             String
  customer               Customer           @relation(fields: [customerId], references: [id])
  planId                 String
  planName               String
  billingFrequency       String             // daily | weekly | monthly | yearly
  status                 String             // DRAFT | QUOTATION | CONFIRMED | ACTIVE | PAUSED | CLOSED
  startDate              DateTime
  expiryDate             DateTime
  nextBillingDate        DateTime
  paymentTerms           String             @default("NET30") // IMMEDIATE | NET15 | NET30 | NET60
  taxReference           String?
  subtotal               Float
  taxTotal               Float
  totalAmount            Float
  autoRenew              Boolean            @default(true)
  renewalNotificationDays Int               @default(14)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  lines                  SubscriptionLine[]
  invoices               Invoice[]
  billingAttempts        BillingAttempt[]
}

model SubscriptionLine {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  productId      String
  product        Product      @relation(fields: [productId], references: [id])
  productName    String
  variantId      String?
  variantName    String?
  quantity       Int
  unitPrice      Float
  taxRate        Float        @default(0)
  taxReference   String?
  lineTotal      Float
}

// ==========================================
// MEMBER 2 MODELS (Billing & Financials)
// ==========================================

model TaxRule {
  id             String        @id @default(cuid())
  name           String
  code           String        @unique
  ratePercentage Float
  country        String
  state          String?
  description    String        @default("")
  isDefault      Boolean       @default(false)
  status         String        @default("active") // active | inactive
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  invoiceLines   InvoiceLine[]
}

model DiscountRule {
  id                 String            @id @default(cuid())
  code               String            @unique
  description        String
  type               String            // percentage | fixed
  value              Float
  minOrderAmount     Float             @default(0)
  validFrom          DateTime
  validUntil         DateTime
  maxUses            Int
  usedCount          Int               @default(0)
  status             String            @default("active") // active | expired | disabled
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  applicableProducts DiscountProduct[]
  invoiceDiscounts   InvoiceDiscount[]
}

model DiscountProduct {
  id             String       @id @default(cuid())
  discountRuleId String
  discountRule   DiscountRule @relation(fields: [discountRuleId], references: [id], onDelete: Cascade)
  productId      String
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([discountRuleId, productId])
}

model Invoice {
  id                 String            @id @default(cuid())
  invoiceNumber      String            @unique
  subscriptionId     String?
  subscription       Subscription?     @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  billingPeriodStart DateTime?
  billingPeriodEnd   DateTime?
  customerId         String
  customer           Customer          @relation(fields: [customerId], references: [id])
  customerName       String
  customerEmail      String
  issueDate          DateTime          @default(now())
  dueDate            DateTime
  status             String            @default("DRAFT") // DRAFT | CONFIRMED | PAID | OVERDUE | CANCELLED
  subtotal           Float             @default(0)
  taxAmount          Float             @default(0)
  discountAmount     Float             @default(0)
  totalAmount        Float             @default(0)
  amountPaid         Float             @default(0)
  amountDue          Float             @default(0)
  paymentTerms       String            @default("NET30")
  notes              String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  lines              InvoiceLine[]
  payments           Payment[]
  discounts          InvoiceDiscount[]
  billingAttempts    BillingAttempt[]

  @@unique([subscriptionId, billingPeriodStart, billingPeriodEnd], name: "unique_subscription_billing_period")
  @@index([customerId])
  @@index([status])
  @@index([dueDate])
}

model InvoiceLine {
  id             String    @id @default(cuid())
  invoiceId      String
  invoice        Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId      String
  product        Product   @relation(fields: [productId], references: [id])
  productName    String
  variantId      String?
  variantName    String?
  quantity       Int       @default(1)
  unitPrice      Float
  taxRuleId      String?
  taxRule        TaxRule?  @relation(fields: [taxRuleId], references: [id], onDelete: SetNull)
  taxRate        Float     @default(0)
  taxAmount      Float     @default(0)
  discountAmount Float     @default(0)
  lineTotal      Float
}

model InvoiceDiscount {
  id             String       @id @default(cuid())
  invoiceId      String
  invoice        Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  discountRuleId String
  discountRule   DiscountRule @relation(fields: [discountRuleId], references: [id], onDelete: Cascade)
  discountCode   String
  discountType   String       // percentage | fixed
  discountValue  Float
  appliedAmount  Float
}

model Payment {
  id            String   @id @default(cuid())
  paymentNumber String   @unique
  invoiceId     String
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id])
  customerName  String
  amount        Float
  paymentMethod String   // Credit Card | Bank Transfer | ACH | Stripe
  paymentDate   DateTime @default(now())
  reference     String
  status        String   @default("completed") // completed | processing | failed
  notes         String?
  createdAt     DateTime @default(now())

  @@index([customerId])
  @@index([invoiceId])
}

model BillingRun {
  id             String           @id @default(cuid())
  startedAt      DateTime         @default(now())
  completedAt    DateTime?
  status         String           @default("running") // running | completed | failed
  totalProcessed Int              @default(0)
  totalSucceeded Int              @default(0)
  totalFailed    Int              @default(0)
  totalSkipped   Int              @default(0)
  errorMessage   String?
  attempts       BillingAttempt[]
}

model BillingAttempt {
  id                 String       @id @default(cuid())
  billingRunId       String
  billingRun         BillingRun   @relation(fields: [billingRunId], references: [id], onDelete: Cascade)
  subscriptionId     String
  subscription       Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  billingPeriodStart DateTime
  billingPeriodEnd   DateTime
  status             String       @default("pending") // pending | success | failed | skipped_duplicate
  invoiceId          String?
  invoice            Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  errorMessage       String?
  attemptNumber      Int          @default(1)
  createdAt          DateTime     @default(now())

  @@index([subscriptionId])
  @@index([status])
}
